# Config for sync_ros2bags.sh
# Copy this file to .env and fill in your own values.
REMOTE_USER="<remote-username>"
REMOTE_HOST="<remote-host-or-ip>"
REMOTE_DIR="/path/on/remote/aerial_tactile_servoing/data/rosbags"
LOCAL_DIR="/path/on/local/aerial_tactile_servoing/data/rosbags"
SSH_KEY="~/.ssh/your_key"
