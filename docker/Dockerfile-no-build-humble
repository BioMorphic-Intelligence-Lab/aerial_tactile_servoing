# Use an official ROS 2 base image (e.g., Humble Hawksbill on Ubuntu 22.04)
# We use 
FROM ros:humble-ros-base

# Set environment variables
ENV ROS_DISTRO=humble
ENV ROS_DOMAIN_ID=75

# Update and install dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    python3-colcon-common-extensions \
    python3-argcomplete \
    bash-completion \
    ros-humble-ament-cmake-clang-format \
    git \
    nano \
    terminator \
    libboost-all-dev \
    python3-pip \
    python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies (for TacTip driver)
RUN pip3 install -U \
    numpy==1.26.4 \
    opencv-python==4.10.0.84 \
    scikit-image==0.24.0 \
    torch==2.5.1 \
    pytorch-model-summary==0.1.2 \
    vit-pytorch==1.8.8 \
    pandas==2.2.3 \
    matplotlib==3.9.2 \
    seaborn==0.13.2

# RK3588 NPU runtime for the TacTip driver's 'rknn' backend (Orange Pi 5). The kernel driver lives
# on the host; the container only needs the user-space runtime library and its Python binding, and
# access to the NPU device node (a /dev/dri render node; --privileged covers it).
# Versions must match the rknn-toolkit2 that converted the models (tools/npu_bench).
# Only installed on arm64, so the image still builds on x86 (where the driver falls back to torch).
ARG RKNN_VERSION=2.3.2
ADD https://github.com/airockchip/rknn-toolkit2/raw/v${RKNN_VERSION}/rknpu2/runtime/Linux/librknn_api/aarch64/librknnrt.so /usr/lib/librknnrt.so
RUN chmod 644 /usr/lib/librknnrt.so && \
    if [ "$(uname -m)" = "aarch64" ]; then \
        pip3 install rknn-toolkit-lite2==${RKNN_VERSION} ; \
    else rm /usr/lib/librknnrt.so ; fi

WORKDIR /ros2_ws/aerial_tactile_servoing
