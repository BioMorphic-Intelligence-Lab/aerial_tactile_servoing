<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="world_demo">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::AirSpeed" filename="gz-sim-air-speed-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>    
    
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
	      <surface>
		<bounce>
		  <restitution_coefficient>0.1</restitution_coefficient>
		</bounce>
		<contact>
		  <ode>
		    <max_vel>100.0</max_vel>
		    <min_depth>0.001</min_depth>
		  </ode>
		</contact>
		<friction>
		  <ode>
		    <mu>100000.0</mu>
		    <mu2>100000.0</mu2>
		  </ode>
		</friction>
	      </surface>                  
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>


    <!--light-->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  
    <!-- Pick-up table. Gazebo is ENU: x is East, y is North, so this is North 2.0, East 0.0.

         Top surface at exactly 1.000 m. The object's centre then sits at 1.000 + half its
         height, which must agree with geom.object_centre_altitude_m in
         ats_bringup/config/grasp_geometry.yaml, which is what the mission hovers above. -->
    <model name="pickup_table">
      <static>true</static>
      <pose>0 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.975 0 0 0</pose>
          <geometry>
            <box>
              <size>0.6 0.6 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.975 0 0 0</pose>
          <geometry>
            <box>
              <size>0.6 0.6 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.42 0.28 1</ambient>
            <diffuse>0.55 0.42 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="column_collision">
          <pose>0 0 0.475 0 0 0</pose>
          <geometry>
            <box>
              <size>0.12 0.12 0.95</size>
            </box>
          </geometry>
        </collision>
        <visual name="column_visual">
          <pose>0 0 0.475 0 0 0</pose>
          <geometry>
            <box>
              <size>0.12 0.12 0.95</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="grasp_object">
      <static>false</static>
      <!-- Centre height = table top (1.000) + half the object's 10 cm height. This must agree
           with geom.object_centre_altitude_m in ats_bringup/config/grasp_geometry.yaml, which is
           what the mission hovers above. -->
      <pose>0 2.0 1.05 0 0 0</pose>
      <link name="link">
        <!-- GROUND-TRUTH MASS AND WIDTH. This is the only place either is defined; neither is
             given to the controller, whose job in design v2 is to MEASURE the width at first
             contact and to set the grip from the load it feels. So this doubles as the test of
             both: set values here, run the mission, and check /grasp/measured_width and
             /grasp/estimated_mass against them.
             Object is a 10 cm cube. In the side grasp the squeeze direction is HORIZONTAL, so
             the 10 cm width is what the shoulders measure; the 10 cm height gives +-5 cm of
             tolerance on where the pads land.
             For a solid box, I = m/12 * (sum of the squares of the two other edges):
                 0.150 kg, 0.10 m cube -> 2.5e-4 about every axis.
             Real object not yet 3D printed; target 100-200 g, which at this size is 0.1-0.2
             g/cm^3, so it has to be hollow or lightly infilled. -->
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>2.5e-4</ixx>
            <iyy>2.5e-4</iyy>
            <izz>2.5e-4</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- Placeholder for silicone dome on printed plastic-->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.1 0.1 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drop-off table, North 2.0, East 2.0.

         Top surface at exactly 1.000 m. The object's centre then sits at 1.000 + half its
         height, which must agree with geom.object_centre_altitude_m in
         ats_bringup/config/grasp_geometry.yaml, which is what the mission hovers above. -->
    <model name="dropoff_table">
      <static>true</static>
      <pose>2.0 2.0 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.975 0 0 0</pose>
          <geometry>
            <box>
              <size>0.6 0.6 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.975 0 0 0</pose>
          <geometry>
            <box>
              <size>0.6 0.6 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.42 0.28 1</ambient>
            <diffuse>0.55 0.42 0.28 1</diffuse>
          </material>
        </visual>
        <collision name="column_collision">
          <pose>0 0 0.475 0 0 0</pose>
          <geometry>
            <box>
              <size>0.12 0.12 0.95</size>
            </box>
          </geometry>
        </collision>
        <visual name="column_visual">
          <pose>0 0 0.475 0 0 0</pose>
          <geometry>
            <box>
              <size>0.12 0.12 0.95</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.38 1</ambient>
            <diffuse>0.35 0.35 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
