  <gazebo reference="base_link">
    <collision name="base_link_collision">
      <surface>
        <bounce>
          <restitution_coefficient>0.01</restitution_coefficient>
        </bounce>
        <contact>
          <ode>
            <max_vel>100.0</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
        <friction>
          <ode>
            <mu>1000000.0</mu>
            <mu2>1000000.0</mu2>
          </ode>
        </friction>
      </surface>        
    </collision>
